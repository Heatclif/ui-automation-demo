{
  "name": "playwright-ui-demo",
  "version": "1.0.0",
  "description": "Multi-website Playwright POM demo (SauceDemo + WebDriverUniversity).",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:saucedemo": "playwright test --project=saucedemo-chromium",
    "test:wdu": "playwright test --project=wdu-chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heatclif/playwright-ui-demo.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Heatclif/playwright-ui-demo/issues"
  },
  "homepage": "https://github.com/Heatclif/playwright-ui-demo#readme"
}
